{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,webp,mp4,woff,woff2}"
    ]
  },
  "globalHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
    "Cross-Origin-Embedder-Policy": "unsafe-none",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
